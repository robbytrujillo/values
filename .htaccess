# ========================
# AKTIFKAN REWRITE
# ========================
RewriteEngine On

# ========================
# HILANGKAN INDEX.PHP
# ========================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# ========================
# FORCE HTTPS (opsional)
# ========================
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ========================
# BLOK AKSES FILE SENSITIF
# ========================
<FilesMatch "(^\.|\.env|composer\.json|composer\.lock|package\.json)">
    Order allow,deny
    Deny from all
</FilesMatch>

# ========================
# BLOK AKSES FOLDER CONFIG
# ========================
RewriteRule ^config/ - [F,L]

# ========================
# PROTEK FILE PHP DI FOLDER UPLOAD
# ========================
RewriteRule ^uploads/.*\.php$ - [F,L]

# ========================
# CACHE STATIC FILE (BIAR CEPAT)
# ========================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ========================
# GZIP COMPRESSION
# ========================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json
</IfModule>

# ========================
# HEADER SECURITY
# ========================
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# ========================
# ERROR HANDLER (opsional)
# ========================
ErrorDocument 404 /404.php
ErrorDocument 403 /403.php